type Transaction {
    id: ID!
    accountId: ID!
    amount: Float!
    currency: String!
    merchantCategory: String
    country: String
    createdAt: String
}

input TransferInput {
    sourceAccountId: ID!
    destinationAccountId: ID!
    amount: Float!
    currency: String!
}

type Query {
    allTransactions: [Transaction]
    transactionsByAccount(accountId: ID!): [Transaction]
}

type Mutation {
    executeTransfer(input: TransferInput!): String
}